# Zenou Unblocked, server configuration.
#
# Copy this file to `.env` in the same folder and fill in one credential.
# `.env` is git-ignored and is never served by the web server.
#
#   cp .env.example .env
#
# One of these two is required. A v4 read access token is preferred.

# v4 read access token (the long JWT from themoviedb.org/settings/api).
# Sent as `Authorization: Bearer <token>`.
TMDB_READ_TOKEN=

# v3 API key (32 hex characters). Sent as `?api_key=`.
# Ignored when TMDB_READ_TOKEN is set.
TMDB_API_KEY=

# Optional. Defaults shown.
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# Optional. Port for the site and API. Default 8123.
# PORT=8123

# Optional. Only for testing against a fixture or a TMDB-compatible mirror.
# Leave unset in normal use.
# TMDB_BASE=https://api.themoviedb.org/3

# Optional. Set to 1 to make /api/players list the sources that did NOT answer,
# with the reason. Useful when a host is suspected dead.
# DEBUG_PLAYERS=0
